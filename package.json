{
  "name": "oasa-mcp",
  "version": "0.1.0",
  "description": "MCP server for Athens public transport (OASA) — live bus/trolley arrivals, vehicle positions, routes, stops and timetables",
  "type": "module",
  "license": "MIT",
  "author": "fabianhogger",
  "bin": {
    "oasa-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:live": "OASA_LIVE=1 vitest run --project live",
    "record": "tsx scripts/record-fixtures.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oasa",
    "athens",
    "greece",
    "transit",
    "bus",
    "trolley",
    "telematics",
    "public-transport"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabianhogger/oasa_mcp.git"
  },
  "bugs": {
    "url": "https://github.com/fabianhogger/oasa_mcp/issues"
  },
  "homepage": "https://github.com/fabianhogger/oasa_mcp#readme"
}
